 * Get proper Arabic plural form
 * There are 4 plural forms in Arabic language:
 * - Form for 2
 * - Form for numbers that end with a number between 3 and 10 (like: 103, 1405, 23409)
 * - Form for numbers that end with a number between 11 and 99 (like: 1099, 278)
 * - Form for numbers above 100 ending with 0, 1 or 2 (like: 100, 232, 3001)
 *
 * @param string  $singular Singular word (e.g., عنصر).
 * @param integer $count    The number (e.g. item count) to determine the proper plural form.
 * @param string  $plural2  Plural form 2 (e.g., عنصران). If NULL [default] retrive from internal JSON dataset.
 * @param string  $plural3  Plural form 3 (e.g., عناصر). If NULL [default] retrive from internal JSON dataset.
 * @param string  $plural4  Plural form 4 (e.g., عنصرا). If NULL [default] retrive from internal JSON dataset.
 * @param bool    $nameOnly Get only the name without the number, e.g., if you want to style numbers separately.
 * @param bool    $isFemale Is Female.
 *
 * @return string Proper plural form of the given singular form
 * @author Khaled Al-Sham'aa <khaled@ar-php.org>
 */";s:9:"startLine";i:4429;s:7:"endLine";i:4498;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";s:10:"ArPHP\I18N";s:18:"declaringClassName";s:17:"ArPHP\I18N\Arabic";s:21:"implementingClassName";s:17:"ArPHP\I18N\Arabic";s:16:"currentClassName";s:17:"ArPHP\I18N\Arabic";s:9:"aliasName";N;}s:12:"stripHarakat";a:20:{s:4:"name";s:12:"stripHarakat";s:10:"parameters";a:6:{s:4:"text";a:13:{s:4:"name";s:4:"text";s:7:"default";N;s:4:"type";N;s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:4513;s:7:"endLine";i:4513;s:11:"startColumn";i:34;s:9:"endColumn";i:38;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:7:"tatweel";a:13:{s:4:"name";s:7:"tatweel";s:7:"default";a:2:{s:4:"code";s:4:"true";s:10:"attributes";a:6:{s:9:"startLine";i:4513;s:7:"endLine";i:4513;s:13:"startTokenPos";i:27255;s:12:"startFilePos";i:153682;s:11:"endTokenPos";i:27255;s:10:"endFilePos";i:153685;}}s:4:"type";N;s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:4513;s:7:"endLine";i:4513;s:11:"startColumn";i:41;s:9:"endColumn";i:55;s:14:"parameterIndex";i:1;s:10:"isOptional";b:1;}s:6:"tanwen";a:13:{s:4:"name";s:6:"tanwen";s:7:"default";a:2:{s:4:"code";s:4:"true";s:10:"attributes";a:6:{s:9:"startLine";i:4513;s:7:"endLine";i:4513;s:13:"startTokenPos";i:27262;s:12:"startFilePos";i:153698;s:11:"endTokenPos";i:27262;s:10:"endFilePos";i:153701;}}s:4:"type";N;s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:4513;s:7:"endLine";i:4513;s:11:"startColumn";i:58;s:9:"endColumn";i:71;s:14:"parameterIndex";i:2;s:10:"isOptional";b:1;}s:6:"shadda";a:13:{s:4:"name";s:6:"shadda";s:7:"default";a:2:{s:4:"code";s:4:"true";s:10:"attributes";a:6:{s:9:"startLine";i:4513;s:7:"endLine";i:4513;s:13:"startTokenPos";i:27269;s:12:"startFilePos";i:153714;s:11:"endToke