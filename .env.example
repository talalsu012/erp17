# ============================================================================
# ERP جامعة البحر الأحمر - ملف البيئة النموذجي
# انسخه إلى .env ثم شغّل: php artisan key:generate
# لا تضع أسراراً حقيقية في هذا الملف؛ .env مستبعد من git.
# ============================================================================

# ---- التطبيق ---------------------------------------------------------------
APP_NAME="ERP Red Sea"
# production | local. لوحة Filament تمنع الدخول خارج local ما لم يطبّق User واجهة FilamentUser.
APP_ENV=production
APP_KEY=
# يجب أن تبقى false في الإنتاج (true يعرض تفاصيل الأخطاء للمستخدم).
APP_DEBUG=false
APP_URL=http://erp15.test
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# مفاتيح قديمة مفصولة بفواصل عند تدوير APP_KEY بلا إبطال الجلسات.
# APP_PREVIOUS_KEYS=
BCRYPT_ROUNDS=12

# ---- قاعدة البيانات (MariaDB) ----------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp15_redsea
DB_USERNAME=erp15
DB_PASSWORD=
# DB_SOCKET=
# DB_SSLMODE=prefer
# MYSQL_ATTR_SSL_CA=

# ---- الجلسات والكاش --------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true خلف HTTPS في الإنتاج.
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
# CACHE_PREFIX=

# ---- الطوابير (الاستيراد والتصدير والنسخ الاحتياطي) --------------------------
# الاستيراد/التصدير في Filament ينفَّذ عبر الطابور؛ مع sync يعمل داخل الطلب نفسه.
# في الإنتاج استخدم database أو redis وشغّل: php artisan queue:work --tries=3 --timeout=300
QUEUE_CONNECTION=database
# DB_QUEUE_RETRY_AFTER=90

# ---- السجلات (Logging) -----------------------------------------------------
# daily يدوّر الملفات ويحذف القديم؛ stack يجمع daily مع slack عند ضبطه.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
# تنبيهات الأخطاء الحرجة إلى Slack (اختياري):
# LOG_SLACK_WEBHOOK_URL=
# LOG_SLACK_USERNAME="ERP Red Sea"

# ---- البريد ----------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- الملفات ---------------------------------------------------------------
# public لصور الطلاب (storage:link مطلوب). المرفقات الحساسة يفضّل ربطها بقرص خاص.
FILESYSTEM_DISK=public

# ---- Sanctum / API البنك ---------------------------------------------------
# نطاقات الواجهات التي تستعمل ملفات تعريف الارتباط مع Sanctum (مفصولة بفواصل).
# SANCTUM_STATEFUL_DOMAINS=
# SANCTUM_TOKEN_PREFIX=

# ---- مزايا النظام ----------------------------------------------------------
# عنوان بوابة الطالب (يُستعمل عند إنشاء حسابات الطلاب).
# STUDENT_PORTAL_URL=
# نطاق بوابة الطالب (مثل students.example.com). الأفضل أمنياً: كوكيز وجلسات معزولة عن لوحة الإدارة.
# إن ترك فارغاً تُخدم البوابة تحت /student على النطاق نفسه.
# STUDENT_PORTAL_DOMAIN=
# true: الشهادات تُصدر من سجل النتائج المعتمد فقط.
RESULTS_CERTIFICATES_FROM_RECORD_ONLY=false
ACTIVITY_LOGGER_ENABLED=true

# ---- خدمات خارجية (اختيارية) -----------------------------------------------
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Throttle the student verification step (true/false)
STUDENT_VERIFY_THROTTLE=true

VITE_APP_NAME="${APP_NAME}"
